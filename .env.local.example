# Shared beta passcode gate (see src/middleware.ts). Leave unset to
# disable the gate entirely — useful for local dev and preview builds.
KNOWSTALGIA_PASSCODE=

# Supabase (Phase 5 content backend). Find both values in the Supabase
# dashboard under Project Settings → API. The anon/publishable key is
# safe to expose publicly — never put a service_role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
